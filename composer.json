{
    "name": "alifcoder/laravel-rabbitmq",
    "description": "Simple RabbitMQ client for Laravel with pub/sub and RPC-style request/response support.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Elbek Khamdullaev",
            "email": "elbek.khamdullaev@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "php-amqplib/php-amqplib": "^3.7",
        "ramsey/uuid": "^4.2"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "Alif\\LaravelRabbitmq\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alif\\LaravelRabbitmq\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Alif\\LaravelRabbitmq\\RabbitmqServiceProvider"
            ],
            "aliases": {
                "Rabbit": "Alif\\LaravelRabbitmq\\Facades\\Rabbit"
            }
        }
    }
}
